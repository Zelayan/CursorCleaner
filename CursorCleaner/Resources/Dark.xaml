<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowColor">#FF171717</Color>
    <Color x:Key="SurfaceColor">#FF242424</Color>
    <Color x:Key="SurfaceAltColor">#FF303030</Color>
    <Color x:Key="SurfaceHoverColor">#FF3A3A3A</Color>
    <Color x:Key="SurfacePressedColor">#FF454545</Color>
    <Color x:Key="BorderColor">#FF626262</Color>
    <Color x:Key="StrongBorderColor">#FF919191</Color>
    <Color x:Key="TextColor">#FFF2F2F2</Color>
    <Color x:Key="MutedTextColor">#FFC4C4C4</Color>
    <Color x:Key="DisabledTextColor">#FF858585</Color>
    <Color x:Key="AccentColor">#FF60CDFF</Color>
    <Color x:Key="AccentHoverColor">#FF7AD6FF</Color>
    <Color x:Key="AccentPressedColor">#FF45B8EC</Color>
    <Color x:Key="AccentSoftColor">#FF183B4D</Color>
    <Color x:Key="AccentTextColor">#FF102027</Color>
    <Color x:Key="WarningColor">#FFFFCC4D</Color>
    <Color x:Key="WarningBackgroundColor">#FF3D3215</Color>
    <Color x:Key="ErrorColor">#FFFF8A80</Color>
    <Color x:Key="ErrorBackgroundColor">#FF481F24</Color>
    <Color x:Key="SuccessColor">#FF79D279</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorBackgroundColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
</ResourceDictionary>
