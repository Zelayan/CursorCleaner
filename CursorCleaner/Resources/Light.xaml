<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowColor">#FFF4F4F4</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFECECEC</Color>
    <Color x:Key="SurfaceHoverColor">#FFE5E5E5</Color>
    <Color x:Key="SurfacePressedColor">#FFDADADA</Color>
    <Color x:Key="BorderColor">#FFB8B8B8</Color>
    <Color x:Key="StrongBorderColor">#FF7A7A7A</Color>
    <Color x:Key="TextColor">#FF1A1A1A</Color>
    <Color x:Key="MutedTextColor">#FF565656</Color>
    <Color x:Key="DisabledTextColor">#FF8A8A8A</Color>
    <Color x:Key="AccentColor">#FF0067C0</Color>
    <Color x:Key="AccentHoverColor">#FF005A9E</Color>
    <Color x:Key="AccentPressedColor">#FF004578</Color>
    <Color x:Key="AccentSoftColor">#FFDCEEFF</Color>
    <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
    <Color x:Key="WarningColor">#FF8A4B00</Color>
    <Color x:Key="WarningBackgroundColor">#FFFFF4CE</Color>
    <Color x:Key="ErrorColor">#FFB10E1C</Color>
    <Color x:Key="ErrorBackgroundColor">#FFFDE7E9</Color>
    <Color x:Key="SuccessColor">#FF0F6B0F</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorBackgroundColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
</ResourceDictionary>
