<Window x:Class="CursorCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cursor Cleaner" Width="1220" Height="760" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="OpenItemMenu"><MenuItem Header="打开所在位置" Command="{Binding DataContext.OpenDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Cursor Cleaner" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Cursor 数据检查与清理工具" Style="{StaticResource MutedText}" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" HorizontalAlignment="Right" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource StatusText}" Tag="{Binding ScanStatusSeverity}" HorizontalAlignment="Right" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding CursorStateText}" Style="{StaticResource StatusText}" Tag="{Binding CursorStatusSeverity}" HorizontalAlignment="Right" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ListBox Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}" SelectedValuePath="Tag" SelectedValue="{Binding SelectedPage, Mode=TwoWay}">
                    <ListBoxItem Tag="0" AutomationProperties.Name="总览"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80F;" Width="28"/><TextBlock Text="总览"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="1" AutomationProperties.Name="历史会话"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" Width="28"/><TextBlock Text="历史会话"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="2" AutomationProperties.Name="工作区"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Width="28"/><TextBlock Text="工作区"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="3" AutomationProperties.Name="空间分析"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D2;" Width="28"/><TextBlock Text="空间分析"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="4" AutomationProperties.Name="高级工具" Visibility="{Binding AdvancedToolsEnabled, Converter={StaticResource BoolVisibilityConverter}}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE90F;" Width="28"/><TextBlock Text="高级工具"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="5" AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" Width="28"/><TextBlock Text="设置"/></StackPanel></ListBoxItem>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="20,16,20,12">
                <!-- 总览 -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=0}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="总览" Style="{StaticResource PageTitle}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="扫描 Cursor 数据"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Margin="0,0,6,0"/><TextBlock Text="扫描"/></StackPanel></Button><Button Command="{Binding CancelScanCommand}" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibilityConverter}}" AutomationProperties.Name="取消扫描"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" Margin="0,0,6,0"/><TextBlock Text="取消扫描"/></StackPanel></Button></StackPanel></Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,8"><StackPanel><TextBlock Text="总占用" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding TotalBytes, Converter={StaticResource ByteSizeConverter}}" Style="{StaticResource StatValue}"/><TextBlock Text="{Binding TotalFiles, StringFormat={}{0:N0} 个文件}" Style="{StaticResource MutedText}"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,8"><StackPanel><TextBlock Text="历史会话" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding SessionBytes, Converter={StaticResource ByteSizeConverter}}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel><TextBlock Text="工作区存储" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding WorkspaceBytes, Converter={StaticResource ByteSizeConverter}}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="SQLite 数据库" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding SqliteBytes, Converter={StaticResource ByteSizeConverter}}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="代理记录" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding AgentBytes, Converter={StaticResource ByteSizeConverter}}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="其他数据" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding OtherBytes, Converter={StaticResource ByteSizeConverter}}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolVisibilityConverter}}"><StackPanel><ProgressBar IsIndeterminate="True"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CurrentScanPath}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ProgressFiles, StringFormat={}{0:N0} 个文件}" Margin="14,0"/><TextBlock Grid.Column="2" Text="{Binding ProgressBytes, Converter={StaticResource ByteSizeConverter}}"/></Grid></StackPanel></Border>
                    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.Name="数据类别"/><TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索扫描结果" AutomationProperties.HelpText="按完整路径筛选"/><TextBlock Grid.Column="3" Text="{Binding ScanVisibleCount, StringFormat=结果 {0:N0}}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                        <Grid Grid.Row="1"><DataGrid ItemsSource="{Binding ScanItemsView}" AutoGenerateColumns="False" ContextMenu="{StaticResource OpenItemMenu}"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding Category, Converter={StaticResource DataCategoryConverter}}" Width="125"/><DataGridTemplateColumn Header="路径" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}" Style="{StaticResource PathText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource ByteSizeConverter}}" SortMemberPath="Size" Width="105"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="本地修改时间" Binding="{Binding LastWriteTimeUtc, Converter={StaticResource UtcToLocalTimeConverter}}" SortMemberPath="LastWriteTimeUtc" Width="145"/><DataGridTextColumn Header="建议" Binding="{Binding Category, Converter={StaticResource CategoryRecommendationConverter}}" Width="210"/></DataGrid.Columns></DataGrid><Border Background="{DynamicResource SurfaceBrush}" Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisibilityConverter}, ConverterParameter=Invert}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="尚未扫描" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="扫描后将在此显示数据文件。扫描不会修改任何文件。" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsScanFilterEmpty, Converter={StaticResource BoolVisibilityConverter}}"><TextBlock Text="没有符合当前类别和搜索条件的结果" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}"/></Border></Grid>
                    </Grid>
                </Grid>

                <!-- 历史会话 -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=1}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="历史会话" Style="{StaticResource PageTitle}"/>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SessionSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索历史会话"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding SessionProjects}" SelectedItem="{Binding SessionProject}" AutomationProperties.Name="项目筛选"/>
                        <TextBlock Grid.Column="3" Text="{Binding SessionVisibleCount, StringFormat=结果 {0:N0}}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                        <Grid>
                            <DataGrid x:Name="SessionsGrid" ItemsSource="{Binding SessionsView}" SelectionMode="Extended" SelectionUnit="FullRow" AutoGenerateColumns="False" SelectionChanged="SessionsGrid_SelectionChanged" ContextMenu="{StaticResource OpenItemMenu}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="会话" Binding="{Binding Title}" Width="2*"/>
                                    <DataGridTextColumn Header="项目" Binding="{Binding ProjectName}" Width="*"/>
                                    <DataGridTextColumn Header="本地时间" Binding="{Binding LastWriteTimeUtc, Converter={StaticResource UtcToLocalTimeConverter}}" SortMemberPath="LastWriteTimeUtc" Width="145"/>
                                    <DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource ByteSizeConverter}}" SortMemberPath="Size" Width="100"/>
                                    <DataGridTemplateColumn Header="路径" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FilePath}" ToolTip="{Binding FilePath}" Style="{StaticResource PathText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsSessionFilterEmpty, Converter={StaticResource BoolVisibilityConverter}}">
                                <TextBlock Text="没有符合筛选条件的历史会话" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                            </Border>
                        </Grid>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding SessionPreviewTitle}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding SessionPreviewTitle}"/>
                                <TextBlock Grid.Row="1" Text="{Binding SessionPreviewStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SessionPreviewMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="8" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayRole}" FontWeight="SemiBold" Foreground="{Binding Role, Converter={StaticResource SessionRoleBrushConverter}}"/>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedSessionCount, StringFormat=已选 {0:N0} 项}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding GenerateSelectedSessionPreviewCommand}" CommandParameter="{Binding SelectedItems, ElementName=SessionsGrid}" Style="{StaticResource PrimaryButton}" Content="为所选会话生成预览" AutomationProperties.Name="为所选会话生成预览"/>
                            <Button Command="{Binding GeneratePreviewCommand}" Content="为全部数据生成预览" AutomationProperties.Name="为全部数据生成预览"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 工作区 -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=2}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="工作区" Style="{StaticResource PageTitle}"/><Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding WorkspaceSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索工作区" AutomationProperties.HelpText="按工作区名称、存储路径或项目路径筛选"/><TextBlock Grid.Column="1" Text="{Binding WorkspaceVisibleCount, StringFormat=结果 {0:N0}}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid><Grid Grid.Row="2"><DataGrid x:Name="WorkspaceGrid" ItemsSource="{Binding WorkspacesView}" SelectionMode="Extended" SelectionUnit="FullRow" AutoGenerateColumns="False" SelectionChanged="WorkspaceGrid_SelectionChanged" ContextMenu="{StaticResource OpenItemMenu}"><DataGrid.Columns><DataGridTextColumn Header="工作区" Binding="{Binding DisplayName}" Width="*"/><DataGridTemplateColumn Header="存储路径" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding WorkspacePath}" ToolTip="{Binding WorkspacePath}" Style="{StaticResource PathText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="项目路径状态" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProjectPath}" ToolTip="{Binding ProjectPath}" Style="{StaticResource PathText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="本地时间" Binding="{Binding LastWriteTimeUtc, Converter={StaticResource UtcToLocalTimeConverter}}" SortMemberPath="LastWriteTimeUtc" Width="140"/><DataGridTextColumn Header="大小" Binding="{Binding TotalBytes, Converter={StaticResource ByteSizeConverter}}" SortMemberPath="TotalBytes" Width="100"/><DataGridTextColumn Header="建议" Binding="{Binding ProjectMissing, Converter={StaticResource WorkspaceRecommendationConverter}}" Width="200"/></DataGrid.Columns></DataGrid><Border Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsWorkspaceFilterEmpty, Converter={StaticResource BoolVisibilityConverter}}"><TextBlock Text="没有符合筛选条件的工作区" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}"/></Border></Grid><Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedWorkspaceCount, StringFormat=已选 {0:N0} 项}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Command="{Binding GenerateSelectedWorkspacePreviewCommand}" CommandParameter="{Binding SelectedItems, ElementName=WorkspaceGrid}" Style="{StaticResource PrimaryButton}" Content="为所选工作区生成预览"/><Button Command="{Binding GeneratePreviewCommand}" Content="为全部数据生成预览"/></StackPanel></Grid></Grid>

                <!-- 空间分析与预览 -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=3}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="空间分析与清理预览" Style="{StaticResource PageTitle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding LargeFiles}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding Category, Converter={StaticResource DataCategoryConverter}}" Width="120"/><DataGridTemplateColumn Header="Top 50 大文件" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}" Style="{StaticResource PathText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource ByteSizeConverter}}" Width="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTemplateColumn Header="打开" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource IconButton}" Command="{Binding DataContext.OpenDirectoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="打开所在位置" AutomationProperties.Name="打开所在位置"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" MinWidth="650"><StackPanel><TextBlock Text="清理策略" Style="{StaticResource SectionHeader}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton Content="保留期限" IsChecked="{Binding IsRetentionPolicy, Mode=OneWay}" Click="RetentionPolicy_Click" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding RetentionDays}" IsEnabled="{Binding IsRetentionPolicy}" Margin="8,0,0,0" AutomationProperties.Name="保留天数"/><RadioButton Grid.Column="3" Content="截止日期" IsChecked="{Binding IsCutoffPolicy, Mode=OneWay}" Click="CutoffPolicy_Click" VerticalAlignment="Center"/><DatePicker Grid.Column="4" SelectedDate="{Binding CustomCutoff}" IsEnabled="{Binding IsCutoffPolicy}" Margin="8,0,0,0" AutomationProperties.Name="清理截止日期"/></Grid><Separator Margin="0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Margin="0,5,0,0" TextWrapping="Wrap"><Run Text="文件 "/><Run Text="{Binding PreviewFiles, Mode=OneWay}"/><Run Text="，工作区 "/><Run Text="{Binding PreviewWorkspaces, Mode=OneWay}"/><Run Text="，会话 "/><Run Text="{Binding PreviewSessions, Mode=OneWay}"/><Run Text="，预计 "/><Run Text="{Binding PreviewBytes, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding OperationStatus}" Style="{StaticResource StatusText}" Tag="{Binding OperationStatusSeverity}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/><TextBlock Text="使用回收站；关闭此设置时将永久删除" Margin="0,5,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><DataTrigger Binding="{Binding UseRecycleBin}" Value="False"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Text" Value="永久删除模式：文件不会进入回收站"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding GeneratePreviewCommand}" Content="为全部数据生成预览"/><Button Command="{Binding CleanupCommand}" Style="{StaticResource PrimaryButton}" Content="开始清理"/><Button Command="{Binding CancelCleanupCommand}" Content="取消清理" Visibility="{Binding IsCleaning, Converter={StaticResource BoolVisibilityConverter}}" AutomationProperties.HelpText="取消后可能已有部分文件完成处理"/></StackPanel></Grid></StackPanel></Border></Grid>

                <!-- 高级工具 -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=4}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="高级工具" Style="{StaticResource PageTitle}"/><Border Grid.Row="1" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><TextBlock Text="数据库维护会先执行完整性检查并强制备份。操作期间必须保持 Cursor 关闭。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/></Border><DataGrid Grid.Row="2" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" AutoGenerateColumns="False" IsEnabled="{Binding CanEditTargets}" ContextMenu="{StaticResource OpenItemMenu}"><DataGrid.Columns><DataGridTemplateColumn Header="数据库" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}" Style="{StaticResource PathText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource ByteSizeConverter}}" Width="110"/><DataGridTextColumn Header="本地修改时间" Binding="{Binding LastWriteTimeUtc, Converter={StaticResource UtcToLocalTimeConverter}}" SortMemberPath="LastWriteTimeUtc" Width="150"/></DataGrid.Columns></DataGrid><Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SqliteStatus}" Style="{StaticResource StatusText}" Tag="{Binding SqliteStatusSeverity}" AutomationProperties.LiveSetting="Assertive"/><TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="维护前 "/><Run Text="{Binding SqliteBefore, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}"/><Run Text="，维护后 "/><Run Text="{Binding SqliteAfter, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}"/><Run Text="，释放 "/><Run Text="{Binding SqliteReclaimed, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding SqliteBackupPath, StringFormat=备份：{0}}" ToolTip="{Binding SqliteBackupPath}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Command="{Binding VacuumCommand}" Style="{StaticResource PrimaryButton}" Content="检查、备份并优化"/></Grid></Grid>

                <!-- 设置 -->
